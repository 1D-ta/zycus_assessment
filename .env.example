# Copy to .env and fill in values. Never commit .env.

# google-genai / Gemini Developer API
GEMINI_API_KEY=
# Configured Gemini model for live provider mode
GEMINI_MODEL=gemini-3.6-flash

# mock | gemini
LLM_PROVIDER=mock

# Optional ISO-8601 UTC timestamp for deterministic 90-day TAM windows.
# Example: 2026-08-27T00:00:00Z
TAM_REFERENCE_NOW=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=onnx
RRF_K=60
RETRIEVAL_TOP_K=5

# Disable Hugging Face network requests (highly recommended for offline/sandboxed execution)
HF_HUB_OFFLINE=1
